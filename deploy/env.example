# /opt/collarbell/.env on the server (chmod 600, never in git). Values in single quotes are taken as they are.

# The public address: file links are signed for it.
PUBLIC_URL=https://collarbell.example.com

# Generated once on the server: openssl rand -hex 24 (the S3 access key: -hex 12).
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# The Gemini key (AI Studio project "Collarbell AI"); empty = reading photos with AI is off.
GEMINI_API_KEY=
# The Firebase service account key as one line of JSON, in single quotes; empty = no pushes.
FIREBASE_SERVICE_ACCOUNT=

# The Telegram bot for alerts (@BotFather) and the owner's chat with it (after /start); empty = alerts only in the log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
