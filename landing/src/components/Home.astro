const { lang } = Astro.props;
const t = COPY[lang];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-text">
      <p class="badge">
        <Icon name="schedule" size={18} />
        <span>{t.hero.badge}</span>
      </p>
      <h1 id="hero-title">{t.hero.title}</h1>
      <p class="lead">{t.hero.lead}</p>
      <p class="muted">{t.hero.note}</p>
      <div class="hero-actions">
        <a class="button button--primary" href="#features">
          <span>{t.hero.cta}</span>
          <Icon name="arrow_downward" size={20} />
        </a>
        <a class="button button--secondary" href={webAppHref(lang)}>
          <Icon name="devices" size={20} />
          <span>{t.hero.web}</span>
        </a>
      </div>
      <p class="muted small">{t.hero.webNote}</p>
    </div>
    <Phone lang={lang} screen="today" alt={t.alt.today} eager sizes="(max-width: 420px) 248px, 282px" />
  </div>
</section>

<section class="section" id="features" aria-labelledby="features-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{t.features.eyebrow}</p>
      <h2 class="h2" id="features-title">{t.features.title}</h2>
      <p class="lead muted">{t.features.intro}</p>
    </div>
    <ul class="features">
      {
        t.features.items.map((item) => (
          <li class="card feature">
            <span class="icon-well">
              <Icon name={item.icon} />
            </span>
            <h3 class="h3">{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<div class="section section--tinted" role="region" aria-label={t.showcasesLabel}>
  <div class="wrap showcases">
    {
      t.showcases.map((row, index) => (
        <section
          class:list={['showcase', index % 2 === 1 && 'showcase--media-first']}
          aria-labelledby={`showcase-${row.id}`}
        >
          <div class="showcase-text">
            <p class="eyebrow">{row.eyebrow}</p>
            <h2 class="h2" id={`showcase-${row.id}`}>
              {row.title}
            </h2>
            <p class="lead">{row.text}</p>
            {row.checks && (
              <ul class="checks">
                {row.checks.map((check) => (
                  <li>
                    <Icon name="check" />
                    <span>{check}</span>
                  </li>
                ))}
              </ul>
            )}
            {row.note && (
              <div class="notice">
                <Icon name="info" />
                <p>{row.note}</p>
              </div>
            )}
          </div>
          <div class="showcase-media">
            {row.screens.length > 1 ? (
              <div class="phones">
                {row.screens.map((screen) => (
                  <Phone lang={lang} screen={screen} alt={t.alt[screen]} sizes="(max-width: 420px) 150px, 240px" />
                ))}
              </div>
            ) : (
              <Phone lang={lang} screen={row.screens[0]} alt={t.alt[row.screens[0]]} />
            )}
          </div>
        </section>
      ))
    }
  </div>
</div>

<section class="section" id="ai" aria-labelledby="ai-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{t.ai.eyebrow}</p>
      <h2 class="h2" id="ai-title">{t.ai.title}</h2>
    </div>
    <ol class="steps">
      {
        t.ai.steps.map((step) => (
          <li class="card step">
            <span class="icon-well">
              <Icon name={step.icon} />
            </span>
            <h3 class="h3">{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
    <div class="notice notice--warning">
      <Icon name="warning" />
      <div>
        <p>{t.ai.warning}</p>
        <p><a href={pageHref(lang, 'privacy')}>{t.ai.more}</a></p>
      </div>
    </div>
  </div>
</section>

<section class="section section--tinted" aria-label={`${t.data.title} · ${t.status.title}`}>
  <div class="wrap columns">
    <div class="card panel">
      <h2 class="h2">{t.data.title}</h2>
      <ul class="checks">
        {
          t.data.checks.map((check) => (
            <li>
              <Icon name="check" />
              <span>{check}</span>
            </li>
          ))
        }
      </ul>
      <p><a href={pageHref(lang, 'privacy')}>{t.data.link}</a></p>
    </div>
    <div class="card panel">
      <h2 class="h2">{t.status.title}</h2>
      <p>{t.status.text}</p>
      <h3 class="h3">{t.status.coming}</h3>
      <ul class="coming">
        {
          t.status.items.map((item) => (
            <li>
              <Icon name={item.icon} />
              <span>{item.label}</span>
            </li>
          ))
        }
      </ul>
      <p><a href={pageHref(lang, 'support')}>{t.status.link}</a></p>
    </div>
  </div>
</section>
