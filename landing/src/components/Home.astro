---
// The home page in both languages: the texts first (English, then Russian), then the layout they share.
// Everything here must be true of the app today (version 0.1); later features are named only as coming.
import Phone from './Phone.astro';
import Icon from './Icon.astro';
import { pageHref, type Lang } from '../i18n';
import type { IconName } from '../icons';
import { webAppHref } from '../site';

interface Props {
  lang: Lang;
}

type Screen = 'today' | 'health' | 'passport' | 'visits' | 'supplies' | 'supply';

interface Showcase {
  id: string;
  eyebrow: string;
  title: string;
  text: string;
  checks?: string[];
  note?: string;
  screens: Screen[];
}

interface Copy {
  hero: { badge: string; title: string; lead: string; note: string; cta: string; web: string; webNote: string };
  features: { eyebrow: string; title: string; intro: string; items: { icon: IconName; title: string; text: string }[] };
  showcasesLabel: string;
  showcases: Showcase[];
  ai: {
    eyebrow: string;
    title: string;
    steps: { icon: IconName; title: string; text: string }[];
    warning: string;
    more: string;
  };
  data: { title: string; checks: string[]; link: string };
  status: { title: string; text: string; coming: string; items: { icon: IconName; label: string }[]; link: string };
  alt: Record<Screen, string>;
}

