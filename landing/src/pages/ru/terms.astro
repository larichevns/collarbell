---
// Условия использования. Правьте вместе с src/pages/terms.astro и датой в src/i18n.ts.
import TextPage from '../../layouts/TextPage.astro';
import Contact from '../../components/Contact.astro';
---

<TextPage
  lang="ru"
  page="terms"
  title="Условия использования"
  description="Условия использования Collarbell на время раннего тестирования."
  dated
>
  <p slot="intro">
    Эти условия действуют для приложения Collarbell, пока оно на раннем тестировании. Пользуясь Collarbell,
    вы соглашаетесь с ними.
  </p>

  <h2 id="what-it-is">Что такое Collarbell</h2>
  <p>
    Личный инструмент, чтобы следить за уходом за питомцами: записи, планы и напоминания. Он на раннем
    тестировании, поэтому что-то может работать не идеально.
  </p>
  <p>Пользоваться Collarbell можно с 18 лет.</p>

  <h2 id="price">Бесплатно на время тестирования</h2>
  <p>Пока идёт тестирование, Collarbell бесплатный.</p>

  <h2 id="as-is">«Как есть»</h2>
  <p>
    Collarbell предоставляется «как есть», без каких-либо гарантий. В нём могут быть ошибки, а его возможности
    могут меняться.
  </p>

  <h2 id="not-advice">Это не ветеринарная консультация</h2>
  <p>
    Collarbell помогает вести записи и напоминает о делах, но не даёт ветеринарных советов. Всегда следуйте
    рекомендациям ветеринара и обращайтесь к нему, если питомцу нехорошо.
  </p>

  <h2 id="passport">Копия паспорта&nbsp;— не официальный документ</h2>
  <p>
    Цифровой паспорт в Collarbell&nbsp;— копия для вашей справки. Официальным документом остаётся бумажный паспорт
    или сертификат&nbsp;— например, у ветеринара или на границе.
  </p>

  <h2 id="reminders">Напоминания могут опаздывать</h2>
  <p>
    Напоминания зависят от телефона и его настроек, от сети и от сторонних сервисов, например Firebase. Они могут
    прийти с опозданием или не прийти совсем. Не полагайтесь только на них, особенно в том, что важно
    для здоровья питомца.
  </p>

  <h2 id="ai">AI может ошибаться</h2>
  <p>AI может неверно прочитать фото. Сверяйте каждый черновик с оригиналом, прежде чем сохранить его.</p>

  <h2 id="content">Ваши материалы</h2>
  <p>
    Всё, что вы вносите в Collarbell, остаётся вашим. Вы отвечаете за то, что у вас есть право это загружать,&nbsp;—
    например, фото и документы.
  </p>

  <h2 id="fair-use">Добросовестное использование</h2>
  <p>
    Не злоупотребляйте Collarbell: не пытайтесь его взломать или перегрузить, получить доступ к чужим данным
    или использовать его для чего-то незаконного.
  </p>

  <h2 id="changes">Изменения и прекращение работы</h2>
  <p>
    Пока идёт тестирование, Collarbell может меняться, а сервис&nbsp;— приостановиться или прекратить работу. Эти
    условия тоже могут измениться: новая версия появится на этой странице с датой, с которой она действует.
  </p>

  <h2 id="contact">Связаться</h2>
  <Contact lang="ru" subject="Collarbell" />
</TextPage>
