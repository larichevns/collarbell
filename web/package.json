{
  "name": "collarbell-web",
  "description": "Collarbell for pet owners on a big screen, at /app/: the same accounts, households and API as the phone app. English and Russian.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "generate-api": "node tool/generate-api.mjs",
    "check-tokens": "node ../landing/tool/gen-tokens.mjs --out src/styles/tokens.css --check && node tool/gen-theme.mjs --check",
    "tokens": "node ../landing/tool/gen-tokens.mjs --out src/styles/tokens.css && node tool/gen-theme.mjs"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@tanstack/react-query": "^5.104.1",
    "firebase": "^12.19.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
